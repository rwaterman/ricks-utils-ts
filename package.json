{
  "name": "@rwaterman/ricks-utils",
  "version": "1.1.0",
  "description": "Typed, small, dependency-free, lightweight async helper/utility functions we use all the time",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "types": "lib/index.d.ts",
  "files": [
    "lib/**/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\" \"*.{json,md}\"",
    "lint": "oxlint --type-aware --deny-warnings src",
    "postversion": "git push && git push --tags",
    "prepare": "npm run build",
    "prepublishOnly": "npm test && npm run lint",
    "preversion": "npm run lint",
    "test": "vitest run",
    "version": "npm run format && git add -A src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rwaterman/ricks-utils-ts.git"
  },
  "keywords": [
    "TypeScript",
    "Library",
    "Async"
  ],
  "author": "Rick Waterman",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
